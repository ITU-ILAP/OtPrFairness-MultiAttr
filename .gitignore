# Trained model checkpoints and logs (can be reproduced by running the code)
model/
log/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Results (generated output — only raw log files, not markdown summaries)
result/
.claude/

# Large per-dataset result dumps (~1.5 GB) — regenerated by the eval scripts.
# The small summary CSVs in results/ (eval_*.csv, raw_runs.csv) are NOT ignored.
results/taobaoserendipity/
results/ml1M/
results/douban/
results/insurance/

# All raw dataset files — download instructions are in dataset/README.md
# Users must download the datasets separately (same convention as the original repo).
dataset/**/*.pkl
dataset/**/*.tsv
dataset/**/*.attacker.*
